# ─────────────────────────────────────────────────────────────
# Etiquette Essentials — environment variables
# Copy to .env.local (local dev) or add in Vercel → Settings →
# Environment Variables (Production).
# Without these the app runs in demo mode (in-memory sample data).
# ─────────────────────────────────────────────────────────────

# Supabase (database + payment-slip storage)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Telegram admin approval bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNO...
TELEGRAM_CHAT_ID=-100123456789
# Optional: only accept webhook calls signed with this token.
# When set, it is sent automatically when you connect the buttons
# from the organizer console.
# TELEGRAM_WEBHOOK_SECRET=

# Ticket emails (Resend)
RESEND_API_KEY=re_123456789...
# Optional: verified-domain sender, e.g.
# EMAIL_FROM=Etiquette Essentials <tickets@yourdomain.com>

# Bank details shown in the registration form (payment step).
# Sample values below — replace with the real account (no code change needed).
# While these are empty/unset, the form shows a
# "confirm with the organizing committee" notice instead.
NEXT_PUBLIC_BANK_NAME=Bank of Ceylon
NEXT_PUBLIC_ACCOUNT_NAME=BEd Intake 5 — Etiquette Essentials
NEXT_PUBLIC_BANK_BRANCH=Nugegoda
NEXT_PUBLIC_ACCOUNT_NUMBER=0072456123

# Organizer console passcode (footer → Organizer console)
ADMIN_KEY=etiquette2027
# ^ default organizer console password — CHANGE this on Vercel to your own

# Optional canonical URL
# NEXT_PUBLIC_SITE_URL=https://etiquette-essentials.vercel.app
